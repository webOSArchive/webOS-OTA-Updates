#!/bin/sh
# otaready-daemon (v2): the root half of the CE OTA client, webOS CE 3.1.0 onward.
#
# System Updates (com.palm.app.updates, patched) and the OTA Ready app are jailed:
# they cannot read system state or write system files. They ask through the
# org.webosarchive.otaready.service bridge, which writes one word into
# /media/internal/.otaready/cmd; this daemon does the work as root and answers in
# files they can read there.
#
#   check    ask the server, verify the signed manifest, write offer.json
#   install  download, verify, prepare the session files, arm, reboot into the
#            stock update ramdisk (the steps of the by-hand recipe in
#            webos-doctor-ce Docs/OTA-HANDOFF.md)
#   cancel   stop a download (the part already fetched is kept and resumed)
#   ack      the user has seen the install result; go back to normal offers
#
# Background checks (at every boot, then weekly) replace the stock
# UpdateDaemon's weekly one, which spoke OMA-DM to Palm's dead server. Like it,
# the first time a background check finds a release, the daemon opens System
# Updates (applicationManager/open, the call the stock daemon made); once per
# release, never before first use is finished.
#
# Trust: nothing the server says is believed until /usr/bin/ce-ota-verify accepts
# the manifest's signature against the key baked into the image. The server only
# decides WHO is offered a release (its releases.json device filter); the signed
# manifest decides WHAT may be installed and on WHICH build. The checks that
# protect the device run here and the server cannot switch them off: the manifest
# must start at this device's build, the pre-flight file must be the image's,
# there must be no custom kernel, and there must be room.
#
# Files (DIR is visible inside the app jails; STATE is root's only):
#   DIR/offer.json            what System Updates shows (its native payload shape)
#   DIR/install-status.json   progress of an install
#   DIR/status.json           a summary for the OTA Ready app
#   STATE/manifest.json(.sig) the last verified manifest
#   STATE/armed               written just before the reboot into the ramdisk
#   STATE/result              the outcome, read after that reboot
#   STAGE/<payload>.ipk       the download (/media/internal: the ramdisk mounts it)
#   DIR/dry-run               bench: do every step of install except arming
#   DIR/server-url            bench: another server (manifests still need the key)

DIR=/media/internal/.otaready
STATE=/var/lib/otaready
STAGE=/media/internal/ce-ota
CMD="$DIR/cmd"
OFFER="$DIR/offer.json"
INSTALL_STATUS="$DIR/install-status.json"
LOG=/var/log/otaready-daemon.log
LOG_MAX=262144                       # bytes; one old copy is kept

VERIFY=/usr/bin/ce-ota-verify
TRUST_KEY=/usr/share/ce-ota/keys/ce-ota-signing.pub
MANIFEST_JS=/usr/share/otaready/ota-manifest.js
NODE=/bin/node
SESSION=/var/lib/software/SessionFiles
STOCK_KERNEL=uImage-2.6.35-palm-tenderloin
RW_LOCK=/tmp/.ce-rootfs-rw.lock      # CE's own lock for remounting /

SERVER_DEFAULT="https://swupdate.webosarchive.org"
CHECK_EVERY=604800                   # seconds between background checks: weekly, like stock
MARGIN_KB=8192                       # slack on every space check
# Space is counted in KB: busybox sh arithmetic is 32-bit, and 13 GB in bytes
# does not fit (awk would even print it as 1.3e+10, which ends the shell).
CLIENT_VERSION=2

log() {
    if [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt "$LOG_MAX" ]; then mv -f "$LOG" "$LOG.1"; fi
    echo "$(date '+%Y-%m-%d %H:%M:%S') otaready: $*" >> "$LOG" 2>&1
}

# A file the jail reads: write it whole, then rename, so a reader never sees half.
put() { printf '%s\n' "$2" > "$1.tmp" && mv -f "$1.tmp" "$1"; }

# Only [A-Za-z0-9 ._:/()+,-] survive into JSON written here.
clean() { printf '%s' "$1" | tr -cd 'A-Za-z0-9 ._:/()+,-' | cut -c1-120; }

server_url() {
    # $DIR/server-url points a bench device at another server. It can only change
    # where manifests come from, never what is accepted: that needs the baked key.
    if [ -f "$DIR/server-url" ]; then
        _u=$(tr -d ' \t\r\n' < "$DIR/server-url" | grep -E '^https?://[A-Za-z0-9.:-]+$')
        [ -n "$_u" ] && { echo "$_u"; return; }
    fi
    echo "$SERVER_DEFAULT"
}

buildmark() { sed -n 's/^BUILDMARK=\([0-9]*\).*/\1/p' /etc/palm-build-info | head -1; }
nduid() { tr -cd '0-9a-f' < /proc/nduid 2>/dev/null | cut -c1-40; }
free_kb() { _f=$(df -k "$1" 2>/dev/null | awk -v m="$1" '$NF==m {printf "%d", $(NF-2)}'); echo "${_f:-0}"; }
mb() { echo $(( ($1 / 1024 + 1023) / 1024 )); }          # bytes -> MB, rounded up
mb_kb() { echo $(( ($1 + 1023) / 1024 )); }              # KB -> MB, rounded up
size_of() { wc -c < "$1" 2>/dev/null || echo 0; }

# --- rootfs write window (CE mounts / read-only) -------------------------------
# /proc/mounts lists "/" twice (initramfs rootfs, then store-root): the LAST is real.
rootfs_is_ro() {
    _o=$(awk '$2=="/" {o=$4} END {print o}' /proc/mounts 2>/dev/null)
    case ",$_o," in *,ro,*) return 0 ;; esac
    return 1
}
rootfs_rw_begin() {
    RO_RESTORE=0
    _n=0
    while ! mkdir "$RW_LOCK" 2>/dev/null && [ $_n -lt 60 ]; do sleep 1; _n=$((_n + 1)); done
    rootfs_is_ro || return 0
    mount -o rw,remount / 2>/dev/null || { log "rootfs: cannot remount rw"; rmdir "$RW_LOCK" 2>/dev/null; return 1; }
    RO_RESTORE=1
}
rootfs_rw_end() {
    if [ "${RO_RESTORE:-0}" = 1 ]; then
        sync
        mount -o ro,remount / 2>/dev/null || log "rootfs: WARNING could not restore ro"
    fi
    RO_RESTORE=0
    rmdir "$RW_LOCK" 2>/dev/null
}

# --- what the jailed apps read ------------------------------------------------
offer_uptodate() {
    put "$OFFER" "{\"status\":\"UpToDate\",\"networkAvailable\":true,\"checked\":$(date +%s)}"
}
offer_network_failed() {
    # Try again sooner after a failure: every minute for the first five (the boot
    # check usually runs before Wi-Fi is up), then every 10 minutes.
    _fails=$(( ${_fails:-0} + 1 ))
    if [ "$_fails" -le 5 ]; then _interval=60; else _interval=600; fi
    put "$OFFER" "{\"status\":\"NetworkFailed\",\"networkAvailable\":false,\"checked\":$(date +%s)}"
}
offer_available() {
    put "$OFFER" "{\"status\":\"Available\",\"version\":\"$M_TITLE\",\"size\":\"$(mb "$M_SIZE")\",\"installTime\":\"$M_MINUTES\",\"networkAvailable\":true,\"checked\":$(date +%s)}"
}
write_status() {   # summary for the OTA Ready app
    put "$DIR/status.json" "{\"client\":$CLIENT_VERSION,\"build\":\"$(buildmark)\",\"version\":\"$(clean "$(sed -n 's/^PRODUCT_VERSION_STRING=//p' /etc/palm-build-info)")\",\"offer\":\"$(clean "$1")\",\"reason\":\"$(clean "$2")\",\"server\":\"$(clean "$(server_url)")\",\"nduid\":\"$(nduid)\",\"time\":$(date +%s)}"
    write_diagnostics
}

# The report Save/Send Device Details hand to the curator (no secrets: build,
# space, kernel link, the last status and the end of this log).
write_diagnostics() {
    {
        echo "webOS Archive OTA Ready diagnostic report (client $CLIENT_VERSION)"
        echo "Generated: $(date '+%Y-%m-%d %H:%M:%S')"
        grep -E '^(PRODUCT_VERSION_STRING|BUILDMARK|BUILDNAME)=' /etc/palm-build-info
        echo "nduid: $(nduid)"
        echo "Server: $(server_url)"
        echo "Kernel: /boot/uImage -> $(readlink /boot/uImage)"
        echo "Free /: $(( $(free_kb /) / 1024 )) MB; free /media/internal: $(( $(free_kb /media/internal) / 1024 )) MB"
        echo; echo "--- status.json ---"; cat "$DIR/status.json" 2>/dev/null
        echo; echo "--- install-status.json ---"; cat "$INSTALL_STATUS" 2>/dev/null
        echo; echo "--- recent daemon log ---"; tail -30 "$LOG" 2>/dev/null
    } > "$DIR/diagnostics.txt.tmp" 2>/dev/null && mv -f "$DIR/diagnostics.txt.tmp" "$DIR/diagnostics.txt"
}

# --- the device's own safety checks (never the server's to override) -----------
kernel_ok() {
    _k=$(readlink /boot/uImage)
    [ "$_k" = "$STOCK_KERNEL" ] || { REASON="a custom kernel is installed (/boot/uImage -> $_k)"; return 1; }
    if grep -qs '^Package: org.webosinternals.kernels\.' /usr/lib/ipkg/status /media/cryptofs/apps/usr/lib/ipkg/status; then
        REASON="a custom kernel package is installed"; return 1
    fi
}

# Load STATE/manifest.json into M_* after checking its signature, then every
# device-side condition for offering it. Sets REASON on refusal.
load_manifest() {
    REASON=""
    [ -f "$STATE/manifest.json" ] || { REASON="no update has been offered"; return 1; }
    "$VERIFY" "$STATE/manifest.json" "$STATE/manifest.json.sig" "$TRUST_KEY" >/dev/null 2>>"$LOG" || { REASON="manifest signature refused"; return 1; }
    _vars=$("$NODE" "$MANIFEST_JS" "$STATE/manifest.json" 2>>"$LOG") || { REASON="manifest not understood by this client"; return 1; }
    eval "$_vars"
    [ "$M_TIER" = "armed-flash" ] || { REASON="tier $M_TIER is not one this client installs"; return 1; }
    [ "$M_FROM" = "$(buildmark)" ] || { REASON="manifest is for build $M_FROM, this device is $(buildmark)"; return 1; }
    _md5=$(md5sum "$M_PREFLIGHT_PATH" 2>/dev/null | cut -d' ' -f1)
    [ "$_md5" = "$M_PREFLIGHT_MD5" ] || { REASON="pre-flight: $M_PREFLIGHT_PATH is not the image's (another build)"; return 1; }
    kernel_ok || return 1
    return 0
}

fetch() {   # fetch URL FILE: fail on HTTP errors, bounded time
    curl -s -f -L -m 60 --connect-timeout 20 -o "$2" "$1" 2>>"$LOG"
}

do_check() {
    _b=$(buildmark)
    if [ ! -f "$TRUST_KEY" ] || [ ! -x "$VERIFY" ]; then
        offer_uptodate; write_status UpToDate "no trust anchor in this image"; return
    fi
    _url=$(server_url)
    _resp=$(curl -s -f -m 30 --connect-timeout 20 "$_url/api/ce-ota/check?build=$_b&nduid=$(nduid)&client=$CLIENT_VERSION" 2>>"$LOG")
    if [ $? -ne 0 ] || [ -z "$_resp" ]; then
        log "check: server unreachable ($_url)"
        offer_network_failed; write_status NetworkFailed "server unreachable"; return
    fi
    _interval=$CHECK_EVERY; _fails=0     # the server answered
    _name=$(echo "$_resp" | sed -n 's/.*"manifest" *: *"\([A-Za-z0-9._-]*\)".*/\1/p')
    if ! echo "$_resp" | grep -q '"status" *: *"Available"' || [ -z "$_name" ]; then
        rm -f "$STATE/manifest.json" "$STATE/manifest.json.sig"
        offer_uptodate; write_status UpToDate ""
        [ "$_last_check" = "UpToDate" ] || log "check: up to date (build $_b)"
        _last_check=UpToDate; return
    fi
    mkdir -p "$STATE/new"
    if ! fetch "$_url/api/ce-ota/manifests/$_name.json" "$STATE/new/manifest.json" ||
       ! fetch "$_url/api/ce-ota/manifests/$_name.json.sig" "$STATE/new/manifest.json.sig"; then
        log "check: could not fetch manifest $_name"
        offer_network_failed; write_status NetworkFailed "manifest download failed"; return
    fi
    mv -f "$STATE/new/manifest.json" "$STATE/manifest.json"
    mv -f "$STATE/new/manifest.json.sig" "$STATE/manifest.json.sig"
    if load_manifest; then
        offer_available; write_status Available "$M_NAME"
        [ "$_last_check" = "$M_NAME" ] || log "check: offering $M_NAME ($M_TITLE)"
        _last_check=$M_NAME
        [ "$1" = background ] && notify_once
    else
        log "check: $_name not offered: $REASON"
        rm -f "$STATE/manifest.json" "$STATE/manifest.json.sig"
        offer_uptodate; write_status UpToDate "$REASON"; _last_check=refused
    fi
}

# Tell the user about a release once, the way the stock UpdateDaemon did: open
# System Updates, which then shows the offer. Only from a background check (a
# user who asked is already looking), only after first use, once per release.
notify_once() {
    [ -f /var/luna/preferences/ran-first-use ] || return 0
    [ "$(cat "$STATE/notified" 2>/dev/null)" = "$M_NAME" ] && return 0
    echo "$M_NAME" > "$STATE/notified"
    log "check: opening System Updates to announce $M_NAME"
    luna-send -n 1 palm://com.palm.applicationManager/open \
        '{"id":"com.palm.app.updates","params":{}}' </dev/null >/dev/null 2>&1 &
}

# --- install -----------------------------------------------------------------
# Every status carries "t" so the app can ignore one left from an earlier attempt.
istatus() { put "$INSTALL_STATUS" "$(echo "$1" | sed "s/^{/{\"t\":$(date +%s),/")"; }
ifail() {
    log "install: FAILED: $1"
    istatus "{\"status\":\"failed\",\"reason\":\"$(clean "$1")\"}"
    rm -f /var/lib/software/updating
}

sha256_of() { /usr/bin/openssl dgst -sha256 "$1" 2>/dev/null | sed 's/.*= *//'; }

ce_job_running() {   # a CE first-boot job is mid-way: do not reboot under it
    initctl list 2>/dev/null | grep ') ce-' | grep -v '(stop) waiting' | grep -q .
}

cancel_requested() {
    [ -f "$CMD" ] && grep -q cancel "$CMD" 2>/dev/null && { rm -f "$CMD"; return 0; }
    return 1
}

download() {
    _part="$STAGE/$M_FILE.part"
    case "$M_URL" in /*) _src="$(server_url)$M_URL" ;; *) _src="$M_URL" ;; esac
    log "install: downloading $_src (have $(size_of "$_part") of $M_SIZE)"
    curl -s -f -L --connect-timeout 30 -C - -o "$_part" "$_src" 2>>"$LOG" &
    _pid=$!
    while kill -0 $_pid 2>/dev/null; do
        # 0-40%: the stock app labels its bar "unpacking" from 45%.
        istatus "{\"status\":\"downloading\",\"percent\":$(( $(size_of "$_part") / 1024 * 40 / (M_SIZE / 1024) ))}"
        if cancel_requested; then kill $_pid 2>/dev/null; wait $_pid 2>/dev/null; return 2; fi
        sleep 2
    done
    wait $_pid
    _rc=$?
    # curl -C - on a file that is already whole exits 33: fine if the size is right.
    _got=$(size_of "$_part")
    if [ "$_got" != "$M_SIZE" ]; then
        log "install: download ended (curl $_rc) with $_got of $M_SIZE bytes"
        [ "$_got" -gt "$M_SIZE" ] && rm -f "$_part"
        return 1
    fi
    mv -f "$_part" "$STAGE/$M_FILE"
}

do_install() {
    istatus '{"status":"preparing","percent":0}'
    log "install: requested"
    load_manifest || { ifail "$REASON"; return; }

    [ -f /var/luna/preferences/ran-first-use ] || { ifail "first use is not finished"; return; }
    ce_job_running && { ifail "the system is still setting up after a restart; try again in a few minutes"; return; }

    # Room on /media/internal for the download, and on / for what the ramdisk
    # writes. Running out on / inside the ramdisk is the one failure no retry
    # repairs, so it is checked with the manifest's own numbers.
    mkdir -p "$STAGE"
    _have=0
    [ -f "$STAGE/$M_FILE.part" ] && _have=$(size_of "$STAGE/$M_FILE.part")
    [ -f "$STAGE/$M_FILE" ] && _have=$M_SIZE
    _need=$(( (M_SIZE - _have) / 1024 + MARGIN_KB )); _free=$(free_kb /media/internal)
    if [ "$_free" -lt "$_need" ]; then
        log "install: /media/internal needs $_need KB, has $_free"
        istatus "{\"status\":\"spaceneeded\",\"where\":\"media\",\"spaceNeeded\":\"$(mb_kb $(( _need - _free ))) MB\"}"; return
    fi
    _need=$(( M_ROOTFS_GROWTH / 1024 + M_LARGEST_FILE / 1024 + MARGIN_KB )); _free=$(free_kb /)
    if [ "$_free" -lt "$_need" ]; then
        log "install: / needs $_need KB, has $_free"
        istatus "{\"status\":\"spaceneeded\",\"where\":\"rootfs\",\"spaceNeeded\":\"$(mb_kb $(( _need - _free ))) MB\"}"; return
    fi

    # Anything else in the stage directory is ours, from an earlier release.
    for _f in "$STAGE"/*; do
        [ -e "$_f" ] || continue
        case "$_f" in "$STAGE/$M_FILE"|"$STAGE/$M_FILE.part") ;; *) rm -f "$_f" ;; esac
    done

    if [ ! -f "$STAGE/$M_FILE" ]; then
        download; _rc=$?
        if [ $_rc -eq 2 ]; then log "install: cancelled"; istatus '{"status":"cancelled"}'; return; fi
        [ $_rc -eq 0 ] || { ifail "the download did not finish; Install again resumes it"; return; }
    fi

    istatus '{"status":"verifying","percent":41}'
    if [ "$(sha256_of "$STAGE/$M_FILE")" != "$M_SHA256" ]; then
        rm -f "$STAGE/$M_FILE"
        ifail "the download was damaged (sha256) and has been deleted; try again"; return
    fi

    # Session files, in the format PmUpdater reads (not a list of URLs): a header
    # line, "version=1", then five lines per package. It counts the records.
    istatus '{"status":"verifying","percent":43}'
    mkdir -p "$SESSION"
    rm -f "$SESSION/update_status.txt" "$SESSION/download_status.txt"
    put "$SESSION/update_list.txt" "$STAGE/$M_FILE"
    put "$SESSION/install_list.txt" "/rootfs$STAGE/$M_FILE"
    put "$SESSION/urls" "urls
version=1
$M_FILE
file://$STAGE/$M_FILE
$M_SIZE
$M_MD5
rootfs"
    /usr/bin/PmUpdater -v >> "$LOG" 2>&1
    _rc=$?
    if [ $_rc -ne 0 ] || [ -s "$SESSION/update_status.txt" ]; then
        ifail "the updater refused the package (PmUpdater -v exit $_rc $(head -c 80 "$SESSION/update_status.txt" 2>/dev/null))"; return
    fi

    # Last look before the point of no return: /media/internal is USB-exported,
    # so the file is hashed again, and the device is checked again.
    istatus '{"status":"verifying","percent":44}'
    [ "$(sha256_of "$STAGE/$M_FILE")" = "$M_SHA256" ] || { ifail "the download changed after it was checked"; return; }
    load_manifest || { ifail "$REASON"; return; }
    ce_job_running && { ifail "the system is busy; try again in a few minutes"; return; }

    # Bench switch: everything above ran for real; stop short of arming.
    if [ -f "$DIR/dry-run" ]; then
        log "install: dry run: ready to arm $M_NAME, stopping here (rm $DIR/dry-run to arm)"
        rm -f "$SESSION/update_list.txt" "$SESSION/install_list.txt" "$SESSION/urls"
        istatus '{"status":"failed","reason":"dry run: everything checked, not armed"}'
        return
    fi

    istatus '{"status":"rebooting","percent":45}'
    put "$STATE/armed" "from=$M_FROM
to=$M_TO
name=$M_NAME
title=$M_TITLE
file=$M_FILE
time=$(date +%s)"
    log "install: ARMING $M_NAME ($M_FROM -> $M_TO)"
    echo 1 > /var/lib/software/updating
    /usr/share/ota-scripts/make-update-uimage </dev/null > /var/log/otaready-uimage.log 2>&1
    _rc=$?
    if [ $_rc -ne 0 ] || [ "$(readlink /boot/uImage)" != "update-uimage" ]; then
        rm -f "$STATE/armed"
        ifail "could not build the update image (make-update-uimage exit $_rc)"; return
    fi
    sleep 3                                   # let System Updates show "restarting"
    log "install: rebooting into the update ramdisk"
    killall fbprogress 2>/dev/null
    sync
    reboot
    sleep 120
}

# --- after the reboot ----------------------------------------------------------
# STATE/armed exists only if we rebooted into the ramdisk. The build we came back
# as tells how it went: the target build = installed; the old build = the ramdisk
# refused or failed and ota.sh put the old system back.
after_reboot() {
    [ -f "$STATE/armed" ] || return 0
    _to=$(sed -n 's/^to=//p' "$STATE/armed"); _from=$(sed -n 's/^from=//p' "$STATE/armed")
    _title=$(sed -n 's/^title=//p' "$STATE/armed"); _file=$(sed -n 's/^file=//p' "$STATE/armed")
    _now=$(buildmark)
    if [ "$_now" = "$_to" ]; then
        log "after reboot: installed $_title ($_from -> $_to)"
        put "$STATE/result" "status=InstallSuccessful
version=$_title"
        rm -f "$STAGE/$_file" "$STATE/manifest.json" "$STATE/manifest.json.sig"
        rmdir "$STAGE" 2>/dev/null
        # /boot/update-uimage is removed by the image's ce-ota-finish.
    else
        log "after reboot: still build $_now; the update to $_to did not install (see /var/log/ota.log.gz)"
        put "$STATE/result" "status=InstallFailed
version=$_title"
    fi
    rm -f "$STATE/armed" "$INSTALL_STATUS"
    announce_result
}

# Show the outcome the way the stock UpdateDaemon did: open System Updates with
# updateSuccessful / installFailed, which its create() turns into the result
# screen (Done sends ack). In the background, after ce-ota-finish has stopped
# (it reinstalls apps for a minute or two on this boot), at most 10 minutes.
announce_result() {
    _s=$(sed -n 's/^status=//p' "$STATE/result")
    _v=$(clean "$(sed -n 's/^version=//p' "$STATE/result")")
    case "$_s" in
        InstallSuccessful) _p=updateSuccessful ;;
        InstallFailed)     _p=installFailed ;;
        *) return 0 ;;
    esac
    (
        _n=0
        while initctl status ce-ota-finish 2>/dev/null | grep -q "start/\|(start)" && [ $_n -lt 600 ]; do
            sleep 5; _n=$((_n + 5))
        done
        sleep 5
        log "after reboot: opening System Updates to show $_s"
        luna-send -n 1 palm://com.palm.applicationManager/open \
            "{\"id\":\"com.palm.app.updates\",\"params\":{\"$_p\":true,\"version\":\"$_v\"}}" </dev/null >/dev/null 2>&1
    ) &
}

# Until the user taps Done, System Updates shows the outcome instead of an offer.
show_result() {
    [ -f "$STATE/result" ] || return 1
    _s=$(sed -n 's/^status=//p' "$STATE/result"); _v=$(sed -n 's/^version=//p' "$STATE/result")
    put "$OFFER" "{\"status\":\"$(clean "$_s")\",\"version\":\"$(clean "$_v")\",\"networkAvailable\":true,\"checked\":$(date +%s)}"
    write_status "$_s" "$_v"
}

# A baked client (the image ships this daemon) removes what a Museum install of
# OTA Ready left on the rootfs: its backups of the stock System Updates, which
# would otherwise be "restored" over the image's own copy.
baked_cleanup() {
    [ -f /usr/share/otaready/baked ] || return 0
    _su=/usr/palm/applications/com.palm.app.updates
    ls "$_su"/app/*.otaready-orig "$_su"/*.otaready-orig >/dev/null 2>&1 || return 0
    rootfs_rw_begin || return 0
    rm -f "$_su"/app/*.otaready-orig "$_su"/*.otaready-orig
    rootfs_rw_end
    log "removed an older OTA Ready's System Updates backups"
}

mkdir -p "$DIR" "$STATE"
chmod 700 "$STATE"
rm -f "$CMD" "$INSTALL_STATUS"       # nothing is in progress at start
log "started (pid $$, client $CLIENT_VERSION, build $(buildmark))"
baked_cleanup
after_reboot
show_result || do_check background
# Wall-clock time, not a count of loop seconds: a sleeping TouchPad does not run
# this loop, so a counter would stretch a week into months.
_last=$(date +%s)
_interval=${_interval:-$CHECK_EVERY}
while true; do
    if [ -f "$CMD" ]; then
        c=$(tr -cd 'a-z' < "$CMD" 2>/dev/null); rm -f "$CMD"
        case "$c" in
            check)   show_result || do_check; _last=$(date +%s) ;;
            install) do_install ;;
            ack)     rm -f "$STATE/result" "$INSTALL_STATUS"; do_check; _last=$(date +%s) ;;
            cancel|"") ;;
            *)       log "cmd: unknown ($c)" ;;
        esac
    fi
    _now=$(date +%s)
    [ "$_now" -lt "$_last" ] && _last=$_now          # the clock was set back
    if [ $(( _now - _last )) -ge "$_interval" ]; then
        [ -f "$STATE/result" ] || do_check background
        _last=$(date +%s)
    fi
    sleep 1
done
